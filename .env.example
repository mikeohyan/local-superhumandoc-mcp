# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Only `SHDOC_`-prefixed keys are read from this file, and none of them are
# exported into the process environment, so a project .env holding other
# credentials can be shared with this server safely. A real environment
# variable overrides the value here. The one exception is
# SHDOC_ALLOW_DESTRUCTIVE below. These rules are set by the
# `config-resolution` topic; see _rfc/README.md.

# Superhuman Docs API bearer token (a UUID). The auth scheme is fixed by the
# `upstream-api` topic; see _rfc/README.md.
# Create one at https://docs.superhuman.com/account
SHDOC_API_KEY=

# The ID of the single Superhuman Docs document this server exposes.
SHDOC_DOC_ID=

# Registers the destructive tools named by the `tool-surface` topic:
# delete_page, clear_page_content, overwrite_page, delete_element,
# delete_rows, and push_button. These are in addition to the always-on read
# and write tools, which this flag does not affect. Enabled only by 1, true,
# yes or on; anything else, including a typo, leaves them unregistered. When
# this file and the environment disagree, the restrictive answer wins, so an
# old export cannot arm these in a project that disables them. Registration
# happens once at startup, so changing this means restarting the server.
# SHDOC_ALLOW_DESTRUCTIVE=false

# Python logging level for the server's own output, which goes to stderr
# because stdout carries the MCP transport. One of CRITICAL, ERROR, WARNING,
# INFO or DEBUG; an unrecognised value is rejected at startup rather than
# silently ignored. Blank or unset means INFO.
# SHDOC_LOG_LEVEL=INFO

# SHDOC_ENV_FILE is deliberately absent from this list. It names which file to
# read and so must be set in the environment, or passed as --env-file; setting
# it inside a file the server has already found does nothing.
