# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# These variable names are provisional: they are fixed properly by the RFC that
# specifies the client. Until then, treat them as a placeholder shape rather
# than a settled interface.

# Superhuman Docs API bearer token (a UUID; see RFC 0008).
# Create one at https://docs.superhuman.com/account
SUPERHUMAN_API_TOKEN=

# The ID of the single Superhuman Docs document this server exposes.
SUPERHUMAN_DOC_ID=
