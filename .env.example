# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# These variable names are provisional. The `config-resolution` topic fixes them
# properly — see _rfc/README.md — and renames them when it ships. Until then,
# treat them as a placeholder shape rather than a settled interface.

# Superhuman Docs API bearer token (a UUID). The auth scheme is fixed by the
# `upstream-api` topic; see _rfc/README.md.
# Create one at https://docs.superhuman.com/account
SUPERHUMAN_API_TOKEN=

# The ID of the single Superhuman Docs document this server exposes.
SUPERHUMAN_DOC_ID=
