# Secrets — never commit. The `config-resolution` topic requires the API token
# never to appear in a committed file; see _rfc/README.md.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.uv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS
.DS_Store

# Note: uv.lock is intentionally NOT ignored — it is committed so builds
# are reproducible.

# Agent worktrees — checkouts of this repo, never content to commit.
.claude/worktrees/
